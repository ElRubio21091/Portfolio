---
interface Props {
  title?: string;
}
const { title = 'Raúl | Portfolio' } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Portfolio de Raúl, desarrollador web." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <style is:global>
      :root {
        --bg: #0d1117;
        --panel: #161b22;
        --line: #2b3440;
        --text: #e6edf3;
        --muted: #9aa7b4;
        --accent: #79c0ff;
        --warm: #ffa657;
        --mono: 'JetBrains Mono', ui-monospace, Consolas, monospace;
        --sans: 'IBM Plex Sans', system-ui, sans-serif;
      }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; scroll-padding-top: 4rem; }
      @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font-family: var(--sans);
        line-height: 1.65;
      }
      a { color: var(--accent); }
      a:focus-visible, button:focus-visible { outline: 2px solid var(--warm); outline-offset: 3px; }
      h1, h2, h3 { font-family: var(--mono); line-height: 1.2; margin: 0 0 1rem; }
      .nav {
        position: sticky; top: 0; z-index: 10;
        display: flex; justify-content: space-between; align-items: center;
        padding: 0.9rem clamp(1rem, 5vw, 3rem);
        background: rgba(13, 17, 23, 0.85);
        backdrop-filter: blur(8px);
        border-bottom: 1px solid var(--line);
        font-family: var(--mono); font-size: 0.9rem;
      }
      .nav nav { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 0.25rem 1.25rem; }
      .nav a { text-decoration: none; color: var(--muted); }
      .nav a:hover, .nav .logo { color: var(--accent); }
      footer {
        padding: 2rem; text-align: center; color: var(--muted);
        font-family: var(--mono); font-size: 0.85rem;
        border-top: 1px solid var(--line);
      }
    </style>
  </head>
  <body>
    <header class="nav">
      <a class="logo" href="#inicio">~/raul</a>
      <nav>
        <a href="#sobre-mi">sobre mí</a>
        <a href="#cv">currículum</a>
        <a href="#habilidades">habilidades</a>
        <a href="#paradigma">paradigma</a>
        <a href="#proyecto">proyecto</a>
        <a href="#certificados">certificados</a>
      </nav>
    </header>
    <slot />
    <footer>© {new Date().getFullYear()} Raúl</footer>
  </body>
</html>