---
// Imágenes en public/habilidades/. Si dejas img vacío ('') se muestra un recuadro.
const tecnicas = [
  { nombre: 'JavaScript', img: '/habilidades/javascript.jpg' },
  { nombre: 'HTML', img: '/habilidades/html.png' },
  { nombre: 'C#', img: '/habilidades/csharp.png' },
  { nombre: 'Idiomas', detalle: 'Castellano · Catalán · Inglés', img: '/habilidades/idiomas.png' },
];

const personales = [
  { nombre: 'Trabajo inteligente', detalle: 'Organizo y priorizo para trabajar mejor, no solo más.', img: '/habilidades/inteligente.png' },
  { nombre: 'Buena comunicación', detalle: 'Me explico con claridad y sé escuchar.', img: '/habilidades/comunicacion.png' },
  { nombre: 'Me motivo fácilmente', detalle: 'Un reto nuevo me da energía para empezar.', img: '/habilidades/motivacion.jpg' },
  { nombre: 'Atención al detalle', detalle: 'Reviso lo que hago hasta que queda bien.', img: '/habilidades/detalle.jpg' },
];
---

<section id="habilidades" class="section">
  <h2>Habilidades</h2>

  <h3 class="group">// técnicas</h3>
  <ul class="hard">
    {
      tecnicas.map((t) => (
        <li>
          <div class:list={['media', { 'has-img': t.img }]}>
            {t.img ? <img src={t.img} alt={t.nombre} loading="lazy" /> : <span aria-hidden="true">img</span>}
          </div>
          <h4>{t.nombre}</h4>
          {t.detalle && <p>{t.detalle}</p>}
        </li>
      ))
    }
  </ul>

  <h3 class="group">// personales</h3>
  <ul class="soft">
    {
      personales.map((p) => (
        <li>
          <div class:list={['media', { 'has-img': p.img }]}>
            {p.img ? <img src={p.img} alt={p.nombre} loading="lazy" /> : <span aria-hidden="true">img</span>}
          </div>
          <div>
            <h4>{p.nombre}</h4>
            <p>{p.detalle}</p>
          </div>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .section { max-width: 62rem; margin: 0 auto; padding: 4.5rem clamp(1rem, 5vw, 3rem); }
  .section h2 { font-size: 1.8rem; color: var(--accent); }
  .group { font-size: 1rem; color: var(--warm); margin: 2rem 0 1rem; }
  ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 1rem; }
  li {
    background: var(--panel); border: 1px solid var(--line); border-radius: 8px;
  }
  .media {
    display: grid; place-items: center;
    border: 1px dashed var(--line); border-radius: 6px; background: var(--bg);
    font-family: var(--mono); font-size: 0.8rem; color: var(--muted);
  }
  .media.has-img { background: #f4f5f7; border-style: solid; overflow: hidden; }
  .media img { width: 100%; height: 100%; object-fit: contain; padding: 0.4rem; }
  h4 { font-family: var(--mono); font-size: 1rem; margin: 0 0 0.25rem; }
  p { margin: 0; color: var(--muted); font-size: 0.9rem; }

  .hard { grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr)); }
  .hard li { padding: 0.75rem; text-align: center; }
  .hard .media { aspect-ratio: 1; margin-bottom: 0.75rem; }

  .soft { grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr)); }
  .soft li { display: flex; gap: 1rem; align-items: center; padding: 0.75rem; }
  .soft .media { width: 6rem; height: 6rem; flex: none; }
  .soft .media img { object-fit: cover; padding: 0; }
</style>
