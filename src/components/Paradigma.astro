---
// De la cima (arriba) a la base (abajo). Edita los textos a tu gusto.
const niveles = [
  { etiqueta: 'cima', puntos: ['Sé siempre puntual.'] },
  {
    etiqueta: 'crecimiento',
    puntos: ['Desarrolla y fortalece tus pasiones.', 'Una buena actitud es la clave del éxito.'],
  },
  {
    etiqueta: 'cimientos',
    puntos: [
      'Haz ejercicio, come bien y cuida a quienes consideras familia.',
      'Trabajando en equipo, los sueños se cumplen.',
      'Vive y deja vivir.',
    ],
  },
];
---

<section id="paradigma" class="section">
  <h2>Paradigma personal</h2>
  <p class="intro">Mis principios, ordenados en tres niveles: lo de abajo sostiene lo de arriba.</p>

  <ol class="pyramid">
    {
      niveles.map((n, i) => (
        <li class={`tier t${i + 1}`}>
          <span class="label">// {n.etiqueta}</span>
          <div class="points">
            {n.puntos.map((p) => <p>{p}</p>)}
          </div>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .section { max-width: 46rem; margin: 0 auto; padding: 4.5rem clamp(1rem, 5vw, 3rem); }
  .section h2 { font-size: 1.8rem; color: var(--accent); }
  .intro { color: var(--muted); margin: 0; }

  .pyramid {
    list-style: none; padding: 0; margin: 2rem auto 0;
    display: grid; gap: 6px;
  }
  .tier {
    display: flex; flex-direction: column; align-items: center; justify-content: flex-end;
    text-align: center; padding: 1rem 1rem 1.25rem; border-radius: 8px;
  }
  .label { font-family: var(--mono); font-size: 0.75rem; margin-bottom: 0.4rem; }
  .points { display: grid; gap: 0.75rem; font-size: 0.9rem; line-height: 1.4; }
  .points p { margin: 0; }

  .t1 { background: var(--warm); color: #0d1117; font-weight: 600; width: 70%; margin: 0 auto; }
  .t2 { background: #1f3a52; color: var(--text); width: 85%; margin: 0 auto; }
  .t2 .label { color: var(--accent); }
  .t3 { background: #243041; color: var(--text); }
  .t3 .label { color: var(--warm); }

  /* En pantallas grandes, forma de pirámide real */
  @media (min-width: 641px) {
    .pyramid { grid-auto-rows: 10.5rem; }
    .tier { border-radius: 0; width: 100%; }
    .t1 { clip-path: polygon(50% 0, 66.67% 100%, 33.33% 100%); padding-inline: 33.33%; }
    .t2 {
      clip-path: polygon(33.33% 0, 66.67% 0, 83.33% 100%, 16.67% 100%);
      padding-inline: 26%;
    }
    .t3 {
      clip-path: polygon(16.67% 0, 83.33% 0, 100% 100%, 0 100%);
      padding-inline: 9%;
    }
    .t2 .points { grid-template-columns: 1fr 1fr; gap: 1rem; }
    .t3 .points { grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  }
</style>
