---
// Añade aquí tus certificados. Imágenes en public/certificados/
const certificados = [
  { titulo: 'V7 · Creación de videojuegos con Unity (avanzado, proyectos)', entidad: 'ClauTIC', anio: '2025', archivo: 'v7-unity-avanzado.jpg' },
  { titulo: 'V6 · Creación de videojuegos con Unity (intermedio)', entidad: 'ClauTIC', anio: '2024', archivo: 'v6-unity-intermedio.jpg' },
  { titulo: 'V5 · Creación de videojuegos con Unity (inicial)', entidad: 'ClauTIC', anio: '2023', archivo: 'v5-unity-inicial.jpg' },
  { titulo: 'V4 · Creación de videojuegos con Unreal, Stencyl y Roblox', entidad: 'ClauTIC', anio: '2022', archivo: 'v4-unreal-roblox.jpg' },
  { titulo: 'V3 · Creación de videojuegos con Scratch (avanzado)', entidad: 'ClauTIC', anio: '2021', archivo: 'v3-scratch-avanzado.jpg' },
  { titulo: 'GBL · Minecraft Exploration, Galaxy, arquitectura y Redstone Lab', entidad: 'ClauTIC', anio: '2019', archivo: 'gbl-minecraft.jpg' },
  { titulo: 'XIII Certamen Nacional de Lectura en Voz Alta', entidad: 'Fundació Enciclopèdia Catalana', anio: '2017', archivo: 'lectura-en-voz-alta.jpg' },
];
---

<section id="certificados" class="section">
  <h2>Certificados</h2>
  <p class="intro">Formación y cursos que he completado. Pulsa en uno para verlo en grande.</p>
  <ul class="grid">
    {
      certificados.map((c) => (
        <li>
          <a href={`/certificados/${c.archivo}`} target="_blank" rel="noopener">
            <img
              src={`/certificados/${c.archivo}`}
              alt={`Certificado: ${c.titulo}`}
              loading="lazy"
              decoding="async"
            />
            <div class="info">
              <h3>{c.titulo}</h3>
              <p>{c.entidad} · {c.anio}</p>
            </div>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .section { max-width: 62rem; margin: 0 auto; padding: 4.5rem clamp(1rem, 5vw, 3rem); }
  .section h2 { font-size: 1.8rem; color: var(--accent); }
  .intro { color: var(--muted); }
  .grid {
    list-style: none; padding: 0; margin: 1.5rem 0 0;
    display: grid; gap: 1.25rem;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
  }
  .grid a {
    display: block; height: 100%;
    background: var(--panel); border: 1px solid var(--line); border-radius: 8px;
    overflow: hidden; text-decoration: none; color: var(--text);
    transition: border-color 0.2s;
  }
  .grid a:hover { border-color: var(--accent); }
  img { display: block; width: 100%; aspect-ratio: 3 / 2; object-fit: cover; background: var(--bg); }
  .info { padding: 0.9rem 1rem; }
  h3 { font-size: 1rem; margin: 0 0 0.25rem; }
  .info p { margin: 0; color: var(--muted); font-size: 0.9rem; }
</style>
